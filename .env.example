# Origem dos dados: "simulada" (sem backend) ou "api" (Spring Boot rodando)
VITE_FONTE_DADOS=simulada

# Endereço da API REST do Spring Boot, usado quando VITE_FONTE_DADOS=api
VITE_URL_API=http://localhost:9018/OrbitAPI/v1

# URL da API usada pelo container, lida do .env pelo docker-compose-orbitweb.yml ao subir a imagem
ORBIT_API_URL=http://localhost:9028/OrbitAPI/v1
